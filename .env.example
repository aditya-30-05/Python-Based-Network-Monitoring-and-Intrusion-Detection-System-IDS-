# ──────────────────────────────────────────────────────────────────────────
# NetSentinel IDS - Environment Configuration Example
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git (it is already listed in .gitignore).
# ──────────────────────────────────────────────────────────────────────────

# ── ntfy Push Notifications ───────────────────────────────────────────────
#
# 1. Install the free ntfy app on your Android phone from:
#    https://play.google.com/store/apps/details?id=io.heckel.ntfy
#
# 2. Open the app and tap the + button to subscribe to a topic.
#    Use a hard-to-guess name, e.g.:  netsentinel-your-name-random42
#
# 3. Paste that exact topic name below (no spaces, no special characters).
#
NTFY_TOPIC=your-unique-hard-to-guess-topic

# ntfy server URL (use the default public server or your self-hosted one).
NTFY_SERVER=https://ntfy.sh

# Set to false to disable all push notifications.
NTFY_NOTIFICATIONS_ENABLED=true

# Minimum severity to notify: INFO | LOW | MEDIUM | HIGH | CRITICAL
# Example: set to HIGH to only get HIGH and CRITICAL alerts.
NTFY_MIN_SEVERITY=LOW

# HTTP request timeout for ntfy API calls (seconds).
NTFY_REQUEST_TIMEOUT=5

# Maximum retry attempts before giving up on a failed notification.
NTFY_MAX_RETRIES=3

# Optional: Bearer token if your topic is access-controlled.
# Leave empty for public topics on ntfy.sh.
NTFY_ACCESS_TOKEN=

# Optional: URL to open when you tap the notification on your phone.
# Example: http://192.168.1.10:5000  (your PC's LAN IP + Flask port)
NTFY_CLICK_URL=

# Maximum alerts that can queue waiting for delivery.
NOTIFICATION_QUEUE_SIZE=100
